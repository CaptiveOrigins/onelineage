{
  "name": "@extantape/onefamily-analysis",
  "version": "0.0.0",
  "private": true,
  "description": "OneFamily analysis: groups DNA matches from the DNA alone, with a seeded Leiden implementation, consensus clustering, two-way side splits and cautious seeded placement. Same inputs and seeds, same answer.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "sideEffects": false,
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --target node22",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@extantape/onefamily-core": "workspace:*"
  },
  "devDependencies": {
    "@extantape/onefamily-connectors": "workspace:*",
    "@extantape/onefamily-simulate": "workspace:*"
  }
}
