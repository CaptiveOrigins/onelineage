{
  "name": "onelineage",
  "private": true,
  "description": "OneLineage: DNA-first genetic genealogy for Mac. Groups your matches before your tree can bias them, and gives odds on every family-tree hypothesis. Runs locally, no servers.",
  "keywords": [
    "genetic-genealogy",
    "dna",
    "genealogy",
    "dna-matches",
    "clustering",
    "family-tree",
    "local-first",
    "privacy"
  ],
  "homepage": "https://github.com/CaptiveOrigins/onelineage#readme",
  "bugs": {
    "url": "https://github.com/CaptiveOrigins/onelineage/issues"
  },
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "oneorigin": "node scripts/oneorigin.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.12"
  }
}
